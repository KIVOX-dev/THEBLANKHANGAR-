# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Applies across both frontend/ and backend/ (patterns are unanchored on purpose).

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend: regenerated by `npm run db:seed` (product SVG art) or written at runtime by the
# admin upload API — not source, safe to ignore. uploads/photos/ is NOT ignored: those are
# manually-sourced stock photos (see CREDITS.md) with no script that regenerates them.
backend/public/uploads/seed/
backend/public/uploads/products/
