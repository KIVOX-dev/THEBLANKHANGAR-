# Server-side base URL for the backend API (never sent to the browser).
BACKEND_URL="http://localhost:4000"
# Public base URL for backend-served images (<Image> tags render in the browser).
NEXT_PUBLIC_ASSET_URL="http://localhost:4000"

# Must match the backend's JWT_SECRET exactly.
JWT_SECRET="replace-me-with-a-long-random-string"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Display-only (checkout payment-method label) — mirrors the backend's PAYMENT_PROVIDER.
NEXT_PUBLIC_PAYMENT_PROVIDER="mock"
