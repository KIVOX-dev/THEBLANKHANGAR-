# MongoDB (replica set required — Prisma uses transactions for order creation and stock moves)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blankhangar?retryWrites=true&w=majority"

PORT=4000
# The frontend's origin — allowed by CORS (mostly a direct-testing convenience; the browser
# only ever calls the frontend in normal use, see README).
FRONTEND_ORIGIN="http://localhost:3000"

# Must match the frontend's JWT_SECRET exactly — both sides verify the same token.
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Leave PAYMENT_PROVIDER=mock to use the built-in mock provider.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# "local" writes uploads to ./public/uploads, served by this server at /uploads/*.
STORAGE_DRIVER="local"

SEED_ADMIN_EMAIL="admin@theblankhangar.com"
SEED_ADMIN_PASSWORD="Admin@12345"
